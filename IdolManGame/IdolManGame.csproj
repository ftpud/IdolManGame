      </Compile>
      <Compile Update="Game\ViewModel\CreateSongView.cs">
        <DependentUpon>CreateSongPage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\Dialogs\IdolViewView.cs">
        <DependentUpon>IdolViewDialog.cs</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
