<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>..\executable\bin\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <OutputPath>..\executable\bin\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\TgUI\UglyAppFramework\UglyAppFramework.csproj" />
      <ProjectReference Include="..\..\TgUI\UglyTgApplication\UglyTgApplication.csproj" />
      <ProjectReference Include="..\EventAdvertisement\EventAdvertisement.csproj" />
      <ProjectReference Include="..\EventAudition\EventAudition.csproj" />
      <ProjectReference Include="..\EventOffersProcessing\EventOffersProcessing.csproj" />
      <ProjectReference Include="..\GameShared\GameShared.csproj" />
      <ProjectReference Include="..\WorldEngine\WorldEngine.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="token.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Game\Repository" />
      <Folder Include="Game\View" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="LiteDB" Version="5.0.15" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Game\ViewModel\AuditionRequestView.cs">
        <DependentUpon>AuditionRequestPage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\ViewModel\AuditionFormsView.cs">
        <DependentUpon>AuditionFormsPage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\ViewModel\MainPageView.cs">
        <DependentUpon>MainPage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\ViewModel\RegistrationView.cs">
        <DependentUpon>RegistrationPage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\ViewModel\WelcomeView.cs">
        <DependentUpon>WelcomePage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\Dialogs\IdolHireView.cs">
        <DependentUpon>IdolHireDialog.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\ViewModel\IdolsViewView.cs">
        <DependentUpon>IdolsViewPage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\ViewModel\EventsView.cs">
        <DependentUpon>EventsPage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\Services\Offers\RadioOfferPages\RadioOfferView.cs">
        <DependentUpon>RadioOfferPage.cs</DependentUpon>
      </Compile>
      <Compile Update="Game\ViewModel\RepertoireView.cs">
